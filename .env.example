# --- Supabase Configuration ---
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Email Service (Resend) ---
RESEND_API_KEY=your_resend_api_key

# --- Administration ---
# Primary admin email for sensitive operations
ADMIN_EMAIL=your_admin_email
# Comma-separated list of emails authorized for dashboard access
ALLOWED_ADMIN_EMAILS=email1@example.com,email2@example.com

# --- SEO & Site Configuration ---
# Used for sitemap generation and OpenGraph absolute URLs
NEXT_PUBLIC_SITE_URL=https://moonchaery-studio.vercel.app
